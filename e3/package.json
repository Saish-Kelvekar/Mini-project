{
  "name": "engine3-database",
  "version": "1.0.0",
  "description": "Engine 3 - Event Transaction & Data Management (Node.js + Express + PostgreSQL)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "db:setup": "node scripts/setupDb.js",
    "db:sample": "node scripts/setupDb.js --sample",
    "db:reset": "node scripts/setupDb.js --reset --sample",
    "db:check": "node scripts/testConnection.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec",
    "test:sql": "node scripts/runSqlTests.js"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "private": true,
  "engines": {
    "node": ">=20.10.0"
  }
}
