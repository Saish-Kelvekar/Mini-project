# Copy this file to ".env" and put your own PostgreSQL password in it.
# Never commit the real .env file.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_timetable
DB_USER=postgres
DB_PASSWORD=change_me

# Separate database used ONLY by `npm test` (name must end with _test).
# It is created automatically and wiped between tests.
DB_NAME_TEST=event_timetable_test

# Optional
PORT=3000
DB_POOL_MAX=10
